# Optional. With both set, the app reads county scores and registry candidates
# from Supabase; without them it boots from the checked-in extract in data/.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by scripts/aggregate-county-scores.ts to write screening
# tables. Never expose this to the browser or set it as a public Vercel var.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Raises the rate limit on scripts/fetch-census-population.mjs.
CENSUS_API_KEY=
